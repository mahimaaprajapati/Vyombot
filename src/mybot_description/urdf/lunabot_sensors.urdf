<robot name="lunabot">

<!-- base footprint on the ground -->
  <link name="base_footprint">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- base_link center at z = 0.325 above ground -->
      <origin xyz="0 0 0.325" rpy="0 0 -1.5708"/>
  </joint>

  <!-- BODY: 1.0 x 0.8 x 0.25 m -->
 <!-- BODY: 1.0 x 0.8 x 0.25 m -->
<link name="base_link">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="20.0"/>
    <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
  </inertial>

  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="1.0 0.8 0.25"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="1.0 0.8 0.25"/>
    </geometry>
  </collision>
</link>
<!-- ISRO logo plate on side of main body -->
<link name="isro_plate_link">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.01"/>
    <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
  </inertial>

  <visual>
    <!-- plate centered in its own frame -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <!-- thin plate: x = along length, y = thickness, z = height -->
      <box size="0.20 0.02 0.10"/>
    </geometry>
    <!-- bright yellow so it's OBVIOUS -->
    <material name="isro_texture">
  <texture filename="file:///home/mahimaa/Vyombot/ros2_ws/src/mybot_description/materials/textures/isro_logo.png"/>
</material>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.20 0.02 0.10"/>
    </geometry>
  </collision>
</link>

<!-- Fix the plate onto the main body -->
<joint name="isro_plate_joint" type="fixed">
  <parent link="base_link"/>
  <child link="isro_plate_link"/>
  <!-- Position on RIGHT side of body near top -->
  <!-- x = 0 (middle front/back)
       y = -0.42 (side, slightly outside ±0.4 body)
       z = 0.10 (near top: body height is 0.25, top is at z=0.125) -->
  <origin xyz="0 -0.42 0.10" rpy="0 0 1.5708"/>
</joint>



  <!-- WHEELS (radius 0.25, width 0.15) -->
  <link name="wheel_fl_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
  <origin xyz="0 0 0" rpy="0 1.5708 0"/>
  <geometry>
    <cylinder radius="0.25" length="0.15"/>
  </geometry>
  <material name="metallic_grey">
    <color rgba="0.32 0.32 0.32 1"/>
  </material>
</visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.15"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="wheel_fl_link">
  <material>Gazebo/DarkGrey</material>
  <surface>
  <friction>
    <ode>
      <mu>3.0</mu>
      <mu2>3.0</mu2>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
    </ode>
  </friction>
</surface>
</gazebo>

  <link name="wheel_fr_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
  <origin xyz="0 0 0" rpy="0 1.5708 0"/>
  <geometry>
    <cylinder radius="0.25" length="0.15"/>
  </geometry>
  <material name="metallic_grey">
    <color rgba="0.32 0.32 0.32 1"/>
  </material>
</visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.15"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="wheel_fr_link">
  <material>Gazebo/DarkGrey</material>
  <surface>
  <friction>
    <ode>
      <mu>3.0</mu>
      <mu2>3.0</mu2>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
    </ode>
  </friction>
</surface>

</gazebo>

  <link name="wheel_rl_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
  <origin xyz="0 0 0" rpy="0 1.5708 0"/>
  <geometry>
    <cylinder radius="0.25" length="0.15"/>
  </geometry>
  <material name="metallic_grey">
    <color rgba="0.32 0.32 0.32 1"/>
  </material>
</visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="wheel_rl_link">
  <material>Gazebo/DarkGrey</material>
  <surface>
  <friction>
    <ode>
      <mu>3.0</mu>
      <mu2>3.0</mu2>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
    </ode>
  </friction>
</surface>

</gazebo>

  <link name="wheel_rr_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
  <origin xyz="0 0 0" rpy="0 1.5708 0"/>
  <geometry>
    <cylinder radius="0.25" length="0.15"/>
  </geometry>
  <material name="metallic_grey">
    <color rgba="0.32 0.32 0.32 1"/>
  </material>
</visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.15"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="wheel_rr_link">
  <material>Gazebo/DarkGrey</material>
  <surface>
  <friction>
    <ode>
      <mu>3.0</mu>
      <mu2>3.0</mu2>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
    </ode>
  </friction>
</surface>

</gazebo>

  <!-- wheel centers should be at z=0.25 above ground => offset -0.075 from base_link -->
  <joint name="wheel_fl_joint" type="continuous">
   <parent link="base_link"/>
    <child link="wheel_fl_link"/>
    <origin xyz="0.40 0.40 -0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  

  <joint name="wheel_fr_joint" type="continuous">
  <parent link="base_link"/>
    <child link="wheel_fr_link"/>
    <origin xyz="0.40 -0.40 -0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <joint name="wheel_rl_joint" type="continuous">
   <parent link="base_link"/>
    <child link="wheel_rl_link"/>
    <origin xyz="-0.40 0.40 -0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  

  <joint name="wheel_rr_joint" type="continuous">
   <parent link="base_link"/>
    <child link="wheel_rr_link"/>
    <origin xyz="-0.40 -0.40 -0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  

  <!-- IMU at body center -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- imu at center of body -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- CAMERA MOUNT BOX at center top of body -->
  <link name="camera_mount_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.20 0.10"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.20 0.10"/>
      </geometry>
    </collision>
  </link>

  <!-- body top is at +0.125, camera box half-height 0.05 => center at 0.175 -->
  <joint name="camera_mount_joint" type="fixed">
  

    <parent link="base_link"/>
    <child link="camera_mount_link"/>
   <origin xyz="0 0 0.175" rpy="0 0 -1.5708"/>
  </joint>

  <!-- MAST on top of camera box -->
  <link name="mast_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.20"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <!-- camera box half-thickness 0.05; mast half-length 0.10; so joint at 0.15 above box center -->
  <joint name="mast_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="mast_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR at top of mast -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.10"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- RGB CAMERA in front of camera box -->
  <link name="rgb_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.08 0.08"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- camera box half-length = 0.2, camera half-length = 0.075 => 0.275 forward -->
  <joint name="rgb_camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="rgb_camera_link"/>
    <origin xyz="0.275 0 0" rpy="0 0 -1.5708"/>
  </joint>

  <!-- DEPTH CAMERA on the front of the main body, looking down -->
  <link name="depth_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.08 0.08"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- body front face at x=+0.5, camera half-length 0.075 => 0.575 forward -->
  <joint name="depth_camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="depth_camera_link"/>
     <origin xyz="0.46 0 -0.14" rpy="0 0.7 0"/>
  </joint>

  <!-- GAZEBO PLUGINS -->
  <gazebo reference="wheel_fl_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <gazebo reference="wheel_fr_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <gazebo reference="wheel_rl_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <gazebo reference="wheel_rr_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>imu:=/imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

<!-- LiDAR sensor -->
<!-- LiDAR sensor -->
<gazebo reference="lidar_link">
  <sensor type="ray" name="lidar_sensor">
    <pose>0 0 0 0 0 0</pose>
    <always_on>true</always_on>
    <update_rate>10</update_rate>
    <visualize>false</visualize>

    <ray>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-3.1416</min_angle>
          <max_angle>3.1416</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.1</min>
        <max>30.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>

    <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <namespace>/lidar</namespace>
        <remapping>~/out:=/scan</remapping>
      </ros>
      <frame_name>lidar_link</frame_name>
     <output_type>sensor_msgs/LaserScan</output_type>
    </plugin>
  </sensor>
</gazebo>



  <!-- RGB camera sensor -->
  <gazebo reference="rgb_camera_link">
    <sensor type="camera" name="rgb_camera_sensor">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>50.0</far>
        </clip>
      </camera>
      <plugin name="rgb_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <remapping>image_raw:=/rgb_camera/image_raw</remapping>
          <remapping>camera_info:=/rgb_camera/camera_info</remapping>
        </ros>
        <frame_name>rgb_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Depth camera sensor -->
  <gazebo reference="depth_camera_link">
    <sensor type="depth" name="depth_camera_sensor">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>30.0</far>
        </clip>
      </camera>
      <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <remapping>image_raw:=/depth_camera/image_raw</remapping>
          <remapping>camera_info:=/depth_camera/camera_info</remapping>
          <remapping>depth:=/depth_camera/depth</remapping>
        </ros>
        <frame_name>depth_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  
 <gazebo>
  <plugin name="lunabot_diff_drive" filename="libgazebo_ros_diff_drive.so">

    <ros>
      <namespace>/</namespace>
      <remapping>cmd_vel:=cmd_vel</remapping>
      <remapping>odom:=odom</remapping>
    </ros>

    <!-- ONLY ONE DRIVE WHEEL PER SIDE -->
    <left_joint>wheel_fl_joint</left_joint>
    <right_joint>wheel_fr_joint</right_joint>

    <wheel_separation>0.80</wheel_separation>
    <wheel_radius>0.25</wheel_radius>

    <robot_base_frame>base_link</robot_base_frame>
    <odometry_frame>odom</odometry_frame>

    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>

    <update_rate>50</update_rate>

  </plugin>
</gazebo>


</robot>

