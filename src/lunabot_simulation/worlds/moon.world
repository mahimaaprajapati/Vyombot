<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='moon_world'>

    <gravity>0 0 -1.62</gravity>

    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0 0 0 1</background>
    </scene>

    <!-- Lunar heightmap -->
    <model name='lunar_heightmap'>
      <static>true</static>
      <link name='link'>

        <visual name='visual'>
          <geometry>
            <heightmap>
              <uri>file://moon_heightmap.png</uri>
              <size>200 200 40</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </visual>

        <collision name='collision'>
          <geometry>
            <heightmap>
              <uri>file://moon_heightmap.png</uri>
              <size>200 200 40</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>

      </link>
    </model>

  </world>
</sdf>

