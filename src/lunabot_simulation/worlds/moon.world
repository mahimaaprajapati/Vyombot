<sdf version="1.6">
  <world name="moon">

    <light name="sun" type="directional">
      <pose>0 0 50 0 0 0</pose>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <model name="moon_surface">
      <static>true</static>

      <link name="link">

        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/mahimaa/Vyombot/ros2_ws/src/lunabot_simulation/models/moon.obj</uri>
              <scale>6 6 2</scale>
            </mesh>
          </geometry>
        </visual>

        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file:///home/mahimaa/Vyombot/ros2_ws/src/lunabot_simulation/models/moon.obj</uri>
              <scale>6 6 2</scale>
            </mesh>
          </geometry>
        </collision>

      </link>
    </model>

  </world>
</sdf>

