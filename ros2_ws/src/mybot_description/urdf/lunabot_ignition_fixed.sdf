<sdf version="1.8">
  <model name="lunabot_final_v2">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_footprint">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="base_link">
      <pose>0 0 0.07 0 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.12</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.12</iyy><iyz>0</iyz><izz>0.12</izz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.50 0.40 0.14</size></box></geometry>
        <material><ambient>1 0.4 0.7 1</ambient><diffuse>1 0.4 0.7 1</diffuse></material>
      </visual>
      <collision name="base_link_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.50 0.40 0.14</size></box></geometry>
      </collision>
    </link>

    <link name="wheel_FL">
      <pose>0.22 0.20 0.02 0 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="wheel_FL_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
      <collision name="wheel_FL_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
    </link>

    <link name="wheel_FR">
      <pose>0.22 -0.20 0.02 0 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="wheel_FR_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
      <collision name="wheel_FR_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
    </link>

    <link name="wheel_RL">
      <pose>-0.22 0.20 0.02 0 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="wheel_RL_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
      <collision name="wheel_RL_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
    </link>

    <link name="wheel_RR">
      <pose>-0.22 -0.20 0.02 0 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="wheel_RR_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
      <collision name="wheel_RR_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
    </link>

    <link name="lidar_link">
      <pose>0 0 0.155 0 0 0</pose> <inertial><mass>0.5</mass><inertia><ixx>0.0015</ixx><iyy>0.0015</iyy><izz>0.0015</izz></inertia></inertial>
      <visual name="lidar_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius> <length>0.12</length></cylinder></geometry>
      </visual>
      <collision name="lidar_link_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.16 0.08 0.04</size></box></geometry>
      </collision>
      <sensor name="lidar_link_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>
          <range><min>0.05</min><max>30</max></range>
        </ray>
      </sensor>
    </link>

    <link name="base_scan"><pose>0 0 0 0 0 0</pose></link>

    <link name="camera_mount">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="camera_mount_visual">
      <pose>0 0 0.025 0 0 0</pose>
        <geometry><box><size>0.1 0.3 0.05</size></box></geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient> <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="camera_mount_collision">
        <geometry><box><size>0.1 0.3 0.05</size></box></geometry>
      </collision>
    </link>

    <link name="camera_optical_frame">
      <inertial>
        <mass>1e-5</mass>
        <inertia>
          <ixx>1e-9</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-9</iyy><iyz>0</iyz><izz>1e-9</izz>
        </inertia>
      </inertial>
    </link>

    <link name="camera_depth_frame">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="camera_depth_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.01</near><far>100</far></clip>
        </camera>
      </sensor>
      <visual name="camera_depth_visual">
      <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient> <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="camera_depth_collision">
        <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
      </collision>
    </link>

    <link name="camera_rgb_frame">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="camera_rgb_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.01</near><far>100</far></clip>
        </camera>
      </sensor>
      <visual name="camera_rgb_visual">
      <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient> <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="camera_rgb_collision">
        <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
      </collision>
    </link>
    
    <link name="imu_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial><mass>0.05</mass></inertial>
      <visual name="imu_link_visual"><pose>0 0 0.03 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
      </visual>
      <sensor name="imu_link_sensor" type="imu">
        <imu>
          <angular_velocity>
            <noise type="gaussian"><mean>0</mean><stddev>0.0001</stddev></noise>
          </angular_velocity>
          <linear_acceleration>
            <noise type="gaussian"><mean>0</mean><stddev>0.0001</stddev></noise>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <joint name="basefootprint_to_baselink" type="fixed">
      <parent>base_footprint</parent><child>base_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <joint name="joint_wheel_FL" type="revolute">
      <parent>base_link</parent><child>wheel_FL</child>
      <pose>0.22 0.20 0.02 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e6</lower><upper>1e6</upper>
          <effort>100</effort><velocity>20</velocity>
        </limit>
        <dynamics><damping>0.01</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <joint name="joint_wheel_FR" type="revolute">
      <parent>base_link</parent><child>wheel_FR</child>
      <pose>0.22 -0.20 0.02 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e6</lower><upper>1e6</upper><effort>100</effort><velocity>20</velocity></limit>
        <dynamics><damping>0.01</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <joint name="joint_wheel_RL" type="revolute">
      <parent>base_link</parent><child>wheel_RL</child>
      <pose>-0.22 0.20 0.02 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e6</lower><upper>1e6</upper><effort>100</effort><velocity>20</velocity></limit>
        <dynamics><damping>0.01</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <joint name="joint_wheel_RR" type="revolute">
      <parent>base_link</parent><child>wheel_RR</child>
      <pose>-0.22 -0.20 0.02 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e6</lower><upper>1e6</upper><effort>100</effort><velocity>20</velocity></limit>
        <dynamics><damping>0.01</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <joint name="joint_lidar" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
      <pose>0 0 0.20 0 0 0</pose> </joint>
    <joint name="lidar_to_base_scan" type="fixed"><parent>lidar_link</parent><child>base_scan</child><pose>0 0 0 0 0 0</pose></joint>

    <joint name="camera_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_mount</child>
      <pose>0.30 0 0.18 0 0 0</pose> 
    </joint>

    <joint name="camera_depth_joint" type="fixed">
      <parent>camera_mount</parent>
      <child>camera_depth_frame</child>
      <pose>0.05 0 -0.05 0 0 0</pose>
    </joint>

    <joint name="camera_rgb_joint" type="fixed">
      <parent>camera_mount</parent>
      <child>camera_rgb_frame</child>
      <pose>0.05 0 0.05 0 0 0</pose>
    </joint>

    <joint name="imu_joint" type="fixed"><parent>base_link</parent><child>imu_link</child><pose>0 0 0.03 0 0 0</pose></joint>
    

<plugin filename="libgz-sim-diff-drive-system.so" name="gz::sim::systems::DiffDrive">
  <left_joint>joint_wheel_FL</left_joint>
  <left_joint>joint_wheel_RL</left_joint>
  
  <right_joint>joint_wheel_FR</right_joint>
  <right_joint>joint_wheel_RR</right_joint>

  <wheel_separation>0.40</wheel_separation>
  <wheel_radius>0.09</wheel_radius>

  <topic>/model/lunabot_final_v2/cmd_vel</topic>
  <odom_topic>/model/lunabot/odom</odom_topic>

  <odom_frame>odom</odom_frame>
  <base_frame>base_link</base_frame>

  <publish_odom>true</publish_odom>
  <publish_tf>true</publish_tf>
  <update_rate>30</update_rate>
</plugin>

    
<plugin name="ros_gz_bridge" filename="libros_gz_sim.so">

  <bridge>
    <topic>/model/lunabot_final_v2/cmd_vel</topic>
    <ros_type>geometry_msgs/msg/Twist</ros_type>
    <gz_type>gz.msgs.Twist</gz_type>
    <direction>ROS_TO_GZ</direction>
  </bridge>

  <bridge>
    <topic>/model/lunabot/odom</topic>
    <ros_type>nav_msgs/msg/Odometry</ros_type>
    <gz_type>gz.msgs.Odometry</gz_type>
    <direction>GZ_TO_ROS</direction>
  </bridge>

  <bridge>
    <topic>/model/lunabot/tf</topic>
    <ros_type>tf2_msgs/msg/TFMessage</ros_type>
    <gz_type>gz.msgs.Pose_V</gz_type>
    <direction>GZ_TO_ROS</direction>
  </bridge>

</plugin>



    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors"/>
  </model>
</sdf>