<?xml version="1.0"?>
<robot name="lunabot_realistic">

  <!-- Materials -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="wheel_gray"><color rgba="0.45 0.45 0.45 1"/></material>
  <material name="sensor_gray"><color rgba="0.75 0.75 0.75 1"/></material>
  <material name="camera_red"><color rgba="0.85 0.15 0.15 1"/></material>
  <material name="dark_gray"><color rgba="0.25 0.25 0.25 1"/></material>

  <!-- ================= BASE (body) ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- length x width x height -->
        <box size="0.50 0.40 0.14"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.40 0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0"
               iyy="0.12" iyz="0.0"
               izz="0.12"/>
    </inertial>
  </link>

  <!-- ================= WHEELS (4 simple) ================= -->
  <!-- wheels are cylinders rotated so axis is Y (spin axis) -->

  <!-- FRONT LEFT -->
  <link name="wheel_FL">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.05"/></geometry>
      <material name="wheel_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0"
               izz="0.001"/>
    </inertial>
  </link>
  <joint name="joint_wheel_FL" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_FL"/>
    <origin xyz="0.22 0.20 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- FRONT RIGHT -->
  <link name="wheel_FR">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.05"/></geometry>
      <material name="wheel_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.7"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0"
               izz="0.001"/>
    </inertial>
  </link>
  <joint name="joint_wheel_FR" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_FR"/>
    <origin xyz="0.22 -0.20 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR LEFT -->
  <link name="wheel_RL">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.05"/></geometry>
      <material name="wheel_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.7"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0"
               izz="0.001"/>
    </inertial>
  </link>
  <joint name="joint_wheel_RL" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_RL"/>
    <origin xyz="-0.22 0.20 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR RIGHT -->
  <link name="wheel_RR">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.05"/></geometry>
      <material name="wheel_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.7"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0"
               izz="0.001"/>
    </inertial>
  </link>
  <joint name="joint_wheel_RR" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_RR"/>
    <origin xyz="-0.22 -0.20 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= 2D LIDAR (rectangular box on top center) ================= -->
  <!-- This is a visual representation only; for simulation you will attach a 2D laser plugin later -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <geometry><box size="0.16 0.08 0.04"/></geometry>
      <material name="sensor_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <geometry><box size="0.16 0.08 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0015" ixy="0" ixz="0"
               iyy="0.0015" iyz="0"
               izz="0.0015"/>
    </inertial>
  </link>
  <joint name="joint_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.155" rpy="0 0 0"/>
  </joint>

  <!-- ================= FRONT RGB CAMERA ================= -->
  <link name="camera_rgb">
    <visual>
      <origin xyz="0.28 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.06 0.04 0.04"/></geometry>
      <material name="camera_red"/>
    </visual>
    <collision>
      <origin xyz="0.28 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.06 0.04 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.28 0 0.06" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0004" ixy="0" ixz="0"
               iyy="0.0004" iyz="0"
               izz="0.0004"/>
    </inertial>
  </link>
  <joint name="joint_camera_rgb" type="fixed">
    <parent link="base_link"/>
    <child link="camera_rgb"/>
    <origin xyz="0.28 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- ================= DEPTH CAMERA (under RGB, stacked) ================= -->
  <link name="camera_depth">
    <visual>
      <origin xyz="0.26 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.06 0.04 0.03"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0.26 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.06 0.04 0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.26 0 0.02" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0"
               izz="0.0003"/>
    </inertial>
  </link>
  <joint name="joint_camera_depth" type="fixed">
    <parent link="base_link"/>
    <child link="camera_depth"/>
    <origin xyz="0.26 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- ================= IMU (small sphere, near center, mostly internal) ================= -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0"
               izz="0.00001"/>
    </inertial>
  </link>
  <joint name="joint_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

</robot>
