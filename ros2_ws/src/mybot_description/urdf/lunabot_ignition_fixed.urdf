<?xml version="1.0"?>
<!-- lunabot_ignition_fixed.urdf
     Ignition-optimized URDF for Lunabot.
     - Includes inertial for all links (no missing inertias)
     - Sensors defined via <gazebo reference="..."> tags using ignition-gazebo-ros2-system
     - Diff-drive plugin compatible with Ignition (libignition-gazebo-diff-drive-system.so)
     - No auto-spawn pose tag.
     - Ready for: gz sdf -p ...  -> ign spawn
-->

<robot name="lunabot_ignition_fixed">

  <!-- Materials (visual only) -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="wheel_gray"><color rgba="0.45 0.45 0.45 1"/></material>
  <material name="sensor_gray"><color rgba="0.75 0.75 0.75 1"/></material>

  <!-- ROOT: small footprint link used for mobile base origin -->
  <link name="base_footprint">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- BASE LINK: chassis geometry, collision, visual, inertial -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box><size>0.50 0.40 0.14</size></box></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box><size>0.50 0.40 0.14</size></box></geometry>
    </collision>
    <inertial>
      <!-- Conservative chassis inertia (replace with CAD numbers later if available) -->
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.12"/>
    </inertial>
  </link>

  <joint name="basefootprint_to_baselink" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ====== WHEELS: FL, FR, RL, RR ====== -->
  <!-- FRONT LEFT -->
  <link name="wheel_FL">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint_wheel_FL" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_FL"/>
    <origin xyz="0.22 0.20 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- FRONT RIGHT -->
  <link name="wheel_FR">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry></collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint_wheel_FR" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_FR"/>
    <origin xyz="0.22 -0.20 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR LEFT -->
  <link name="wheel_RL">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry></collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint_wheel_RL" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_RL"/>
    <origin xyz="-0.22 0.20 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR RIGHT -->
  <link name="wheel_RR">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry></collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint_wheel_RR" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_RR"/>
    <origin xyz="-0.22 -0.20 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ====== LIDAR: link + fixed joint ====== -->
  <link name="lidar_link">
    <visual><origin xyz="0 0 0.155" rpy="0 0 0"/><geometry><box><size>0.16 0.08 0.04</size></box></geometry></visual>
    <collision><origin xyz="0 0 0.155" rpy="0 0 0"/><geometry><box><size>0.16 0.08 0.04</size></box></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
    </inertial>
  </link>

  <joint name="joint_lidar" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 0.155" rpy="0 0 0"/>
  </joint>

  <!-- base_scan: small inertial link used for SLAM frame -->
  <link name="base_scan">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="lidar_to_base_scan" type="fixed">
    <parent link="lidar_link"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ====== RGB CAMERA ====== -->
  <link name="camera_link">
    <visual><origin xyz="0.28 0 0.06" rpy="0 0 0"/><geometry><box><size>0.06 0.04 0.04</size></box></geometry></visual>
    <collision><origin xyz="0.28 0 0.06" rpy="0 0 0"/><geometry><box><size>0.06 0.04 0.04</size></box></geometry></collision>
    <inertial>
      <origin xyz="0.28 0 0.06" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="camera_link_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.28 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- rotation: optical frame points forward/down per convention -->
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
  </joint>

  <!-- ====== DEPTH CAMERA ====== -->
  <link name="camera_depth">
    <visual><origin xyz="0.26 0 0.02" rpy="0 0 0"/><geometry><box><size>0.06 0.04 0.03</size></box></geometry></visual>
    <collision><origin xyz="0.26 0 0.02" rpy="0 0 0"/><geometry><box><size>0.06 0.04 0.03</size></box></geometry></collision>
    <inertial>
      <origin xyz="0.26 0 0.02" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="camera_depth_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_depth"/>
    <origin xyz="0.26 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_depth_frame_joint" type="fixed">
    <parent link="camera_depth"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_optical_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
  </joint>

  <!-- ====== IMU ====== -->
  <link name="imu_link">
    <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><sphere><radius>0.02</radius></sphere></geometry></visual>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- ===================== GAZEBO (Ignition) SENSORS & PLUGINS ===================== -->

  <!-- LIDAR: ignition lidar (ray) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-1.57</min_angle>
            <max_angle>1.57</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>30</max>
        </range>
      </ray>
      <!-- ignition ros2 plugin: publishes /scan -->
      <plugin name="gz_lidar" filename="ignition-gazebo-ros2-system">
        <topic>/scan</topic>
      </plugin>
    </sensor>
  </gazebo>

  <!-- RGB camera -->
  <gazebo reference="camera_link">
    <sensor name="rgb_cam" type="camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.01</near><far>100</far></clip>
      </camera>
      <update_rate>30</update_rate>
      <plugin name="gz_rgb" filename="ignition-gazebo-ros2-system">
        <topic>/camera/image</topic>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Depth camera -->
  <gazebo reference="camera_depth">
    <sensor name="depth_cam" type="depth">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.01</near><far>20</far></clip>
      </camera>
      <update_rate>30</update_rate>
      <plugin name="gz_depth" filename="ignition-gazebo-ros2-system">
        <topic>/camera/depth/image</topic>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <plugin name="gz_imu" filename="ignition-gazebo-ros2-system">
        <topic>/imu</topic>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== DIFF DRIVE PLUGIN (Ignition) ===================== -->
  <!-- plugin attached to base_link -->
  <gazebo reference="base_link">
    <plugin name="ign_diff_drive" filename="libignition-gazebo-diff-drive-system.so">
      <left_wheels>
        <wheel>joint_wheel_FL</wheel>
        <wheel>joint_wheel_RL</wheel>
      </left_wheels>
      <right_wheels>
        <wheel>joint_wheel_FR</wheel>
        <wheel>joint_wheel_RR</wheel>
      </right_wheels>
      <wheel_separation>0.40</wheel_separation>
      <wheel_radius>0.09</wheel_radius>

      <!-- topics -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>

      <!-- frames -->
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <enable_odom_tf>1</enable_odom_tf>
    </plugin>
  </gazebo>

</robot>
