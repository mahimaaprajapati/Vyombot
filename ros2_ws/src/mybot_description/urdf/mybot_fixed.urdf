<?xml version="1.0"?>
<robot name="lunabot_standard_fixed">

  <!-- Materials -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="wheel_gray"><color rgba="0.45 0.45 0.45 1"/></material>
  <material name="sensor_gray"><color rgba="0.75 0.75 0.75 1"/></material>
  <material name="camera_red"><color rgba="0.85 0.15 0.15 1"/></material>
  <material name="dark_gray"><color rgba="0.25 0.25 0.25 1"/></material>

  <!-- ========== ROOT (base_footprint) ========== -->
  <link name="base_footprint">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ========== BASE LINK ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.50 0.40 0.14"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.50 0.40 0.14"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.12"/>
    </inertial>
  </link>

  <joint name="basefootprint_to_baselink" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========== WHEELS ========== -->
  <link name="wheel_FL">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.09" length="0.05"/></geometry><material name="wheel_gray"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.09" length="0.05"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.7"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint_wheel_FL" type="continuous">
    <parent link="base_link"/><child link="wheel_FL"/>
    <origin xyz="0.22 0.20 -0.07" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="10.0"/><dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="wheel_FR">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.09" length="0.05"/></geometry><material name="wheel_gray"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.09" length="0.05"/></geometry></collision>
    <inertial><mass value="0.7"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint_wheel_FR" type="continuous">
    <parent link="base_link"/><child link="wheel_FR"/>
    <origin xyz="0.22 -0.20 -0.07" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="10.0"/><dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="wheel_RL">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.09" length="0.05"/></geometry><material name="wheel_gray"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.09" length="0.05"/></geometry></collision>
    <inertial><mass value="0.7"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint_wheel_RL" type="continuous">
    <parent link="base_link"/><child link="wheel_RL"/>
    <origin xyz="-0.22 0.20 -0.07" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="10.0"/><dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="wheel_RR">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.09" length="0.05"/></geometry><material name="wheel_gray"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.09" length="0.05"/></geometry></collision>
    <inertial><mass value="0.7"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint_wheel_RR" type="continuous">
    <parent link="base_link"/><child link="wheel_RR"/>
    <origin xyz="-0.22 -0.20 -0.07" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="10.0"/><dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- ========== LIDAR ========== -->
  <link name="lidar_link">
    <visual><origin xyz="0 0 0.155" rpy="0 0 0"/><geometry><box size="0.16 0.08 0.04"/></geometry><material name="sensor_gray"/></visual>
    <collision><origin xyz="0 0 0.155" rpy="0 0 0"/><geometry><box size="0.16 0.08 0.04"/></geometry></collision>
    <inertial><origin xyz="0 0 0.155"/><mass value="0.5"/><inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/></inertial>
  </link>
  <joint name="joint_lidar" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.155" rpy="0 0 0"/>
  </joint>

  <!-- alias: base_scan (child of lidar) -->
  <link name="base_scan"/>
  <joint name="lidar_to_base_scan" type="fixed">
    <parent link="lidar_link"/>
    <child  link="base_scan"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========== RGB CAMERA ========== -->
  <link name="camera_link">
    <visual><origin xyz="0.28 0 0.06" rpy="0 0 0"/><geometry><box size="0.06 0.04 0.04"/></geometry><material name="camera_red"/></visual>
    <collision><origin xyz="0.28 0 0.06" rpy="0 0 0"/><geometry><box size="0.06 0.04 0.04"/></geometry></collision>
    <inertial><origin xyz="0.28 0 0.06"/><mass value="0.12"/><inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/></inertial>
  </link>
  <joint name="camera_link_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/><origin xyz="0.28 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_link_to_optical" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/><origin xyz="0 0 0" rpy="-1.5708 0 0"/>
  </joint>

  <!-- ========== DEPTH CAMERA ========== -->
  <link name="camera_depth">
    <visual><origin xyz="0.26 0 0.02" rpy="0 0 0"/><geometry><box size="0.06 0.04 0.03"/></geometry><material name="dark_gray"/></visual>
    <collision><origin xyz="0.26 0 0.02" rpy="0 0 0"/><geometry><box size="0.06 0.04 0.03"/></geometry></collision>
    <inertial><origin xyz="0.26 0 0.02"/><mass value="0.12"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
  </link>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="base_link"/><child link="camera_depth"/><origin xyz="0.26 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_frame"/>
  <joint name="camera_depth_to_frame" type="fixed">
    <parent link="camera_depth"/><child link="camera_depth_frame"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_frame_to_optical" type="fixed">
    <parent link="camera_depth_frame"/><child link="camera_depth_optical_frame"/><origin xyz="0 0 0" rpy="-1.5708 0 0"/>
  </joint>

  <!-- ========== IMU ========== -->
  <link name="imu_link">
    <visual><origin xyz="0 0 0.03"/><geometry><sphere radius="0.02"/></geometry><material name="dark_gray"/></visual>
    <inertial><origin xyz="0 0 0.03"/><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- ========== WHEEL FRICTION (Gazebo) ========== -->
  <gazebo reference="wheel_FL"><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></gazebo>
  <gazebo reference="wheel_FR"><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></gazebo>
  <gazebo reference="wheel_RL"><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></gazebo>
  <gazebo reference="wheel_RR"><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></gazebo>

  <!-- ========== SENSORS (Ignition placeholders) ========== -->
  <gazebo reference="lidar_link">
    <pose>0 0 0.155 0 0 0</pose>
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-1.5708</min_angle><max_angle>1.5708</max_angle></horizontal></scan>
        <range><min>0.05</min><max>30.0</max></range>
      </ray>
      <plugin filename="libignition-gazebo-systems-sensors.so" name="ignition::gazebo::systems::Ray"/>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <pose>0.28 0 0.06 0 0 0</pose>
    <sensor type="camera" name="camera_rgb_sensor">
      <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.01</near><far>100</far></clip></camera>
      <update_rate>30</update_rate>
      <plugin filename="libignition-gazebo-systems-sensors.so" name="ignition::gazebo::systems::Camera"/>
    </sensor>
  </gazebo>

  <gazebo reference="camera_depth">
    <pose>0.26 0 0.02 0 0 0</pose>
    <sensor type="depth" name="camera_depth_sensor">
      <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.01</near><far>20</far></clip></camera>
      <update_rate>30</update_rate>
      <plugin filename="libignition-gazebo-systems-sensors.so" name="ignition::gazebo::systems::DepthCamera"/>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <pose>0 0 0.03 0 0 0</pose>
    <sensor type="imu" name="imu_sensor">
      <always_on>1</always_on>
      <update_rate>200</update_rate>
      <plugin filename="libignition-gazebo-systems-sensors.so" name="ignition::gazebo::systems::Imu"/>
    </sensor>
  </gazebo>

  <!-- ========== DIFF-DRIVE PLUGIN (Ignition placeholder) ========== -->
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DifferentialDrive">
      <left_wheels><wheel>joint_wheel_FL</wheel><wheel>joint_wheel_RL</wheel></left_wheels>
      <right_wheels><wheel>joint_wheel_FR</wheel><wheel>joint_wheel_RR</wheel></right_wheels>
      <wheel_separation>0.40</wheel_separation>
      <wheel_radius>0.09</wheel_radius>
      <cmd_vel_topic>cmd_vel</cmd_vel_topic>
      <odom_topic>odom</odom_topic>
      <publish_odometry>true</publish_odometry>
      <max_wheel_speed>10.0</max_wheel_speed>
      <wheel_accel>5.0</wheel_accel>
    </plugin>
  </gazebo>

</robot>
