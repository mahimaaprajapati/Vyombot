<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="moon_world">

    <!-- Sun Light -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <!-- Moon Terrain -->
    <include>
      <uri>model://moon_surface11</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>

