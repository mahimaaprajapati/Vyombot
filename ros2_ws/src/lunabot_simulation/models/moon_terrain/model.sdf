<?xml version="1.0"?>
<sdf version="1.6">
  <model name="moon_terrain">
    <static>true</static>

    <link name="terrain_link">
      <visual name="terrain_visual">
        <geometry>
          <mesh>
            <uri>model://moon_terrain/meshes/moon_surface.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="terrain_collision">
        <geometry>
          <mesh>
            <uri>model://moon_terrain/meshes/moon_surface.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>

